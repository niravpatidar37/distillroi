# Names only - never commit values. Local scripts load F:/.secrets/portfolio.env (override with PORTFOLIO_ENV_FILE).
GROQ_API_KEY=
HF_TOKEN=
# spend caps in USD (portfolio-wide / this project): 25 / 7
LLM_SPEND_CAP_USD=
PROJECT_SPEND_CAP_USD=
LLM_SPEND_LEDGER=F:/.llm-spend/ledger.jsonl

# router
STUDENT_BASE_URL=http://127.0.0.1:8105/v1
STUDENT_MODEL=distill-student
STUDENT_GCP_ID_TOKEN=false
ROUTER_THRESHOLD=0.5
TEACHER_ENABLED=true
ROUTER_API_KEY=
TEACHER_MODEL=openai/gpt-oss-120b
TEACHER_REASONING_EFFORT=low

# training (W&B offline; sync later with `wandb sync wandb/offline-run-*`)
WANDB_MODE=offline
