[18.875, "o", "\u001b[1mbanking77 test, n=770 (results/benchmark.json)\u001b[0m"]
[18.875, "o", "\r\n\u001b[2msystem                               accuracy  of teacher  $/1K @1M/day       p50 / p95\u001b[0m\r\nteacher  gpt-oss-120b (Groq)            81.2%      100.0%        $0.111    443 / 566 ms\r\nstudent  1.5B q15_r16 (vLLM)            73.2%       90.2%        $0.025     78 / 114 ms\r\nrouted   conf < 0.82 -> teacher         80.9%       99.7%        $0.056  568 / 1708 ms*\r\n\u001b[2mlatency at c=1; *routed = live end-to-end at c=2 incl. real escalations\u001b[0m\r\n\r\n"]
[18.875, "o", "\u001b[1mbreak-even\u001b[0m  V* = 24*H / ((1-e)*c_t)\r\n  H = $1.0465/GPU-hour (Cloud Run L4, estimate)   c_t = $0.000111/request   e = 0.281\r\n"]
[18.875, "o", "  \u001b[33m\u001b[1mV* = 313,375 requests/day\u001b[0m\u001b[33m: above it the routed student is cheaper than the API\u001b[0m\r\n"]
[24.891, "o", "\u001b[1;33m# model weights stay local (artifacts/ is gitignored); next: docker compose down\u001b[0m\r\n"]
[25.906, "o", "\r\n"]
